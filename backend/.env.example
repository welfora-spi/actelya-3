MONGO_URL="mongodb://localhost:27017"
DB_NAME="actelya3_db"
FRONTEND_URL="http://localhost:3000"
JWT_SECRET=""
MASTER_KEY=""
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Optional one-shot administrative reset. Keep false in normal operation.
FORCE_RESET_ADMIN="false"

# M2 worker tuning. Safe defaults used by the application when omitted.
M2_MAX_ATTEMPTS="3"
M2_LEASE_SECONDS="30"

# General per-IP rate limit on POST /auth/login (attempts per minute), distinct
# from the existing per-IP+email lockout after repeated failed attempts (5
# failures -> 15 minute lock, unaffected by this setting). Default 10/minute.
LOGIN_RATE_LIMIT_PER_MINUTE="10"

# The Brain content gateway is intentionally mock-only in this release.
BRAIN_PROVIDER_GATEWAY="mock"

# ===== Social Media Manager — pubblicazione reale (Meta: Facebook/Instagram) =====
# Interruttore di sicurezza GLOBALE (mai una credenziale): entrambi devono
# essere impostati esplicitamente perche' una pubblicazione reale sia anche
# solo TENTATA — il default (assente/qualunque altro valore) resta sempre
# sicuro (dry-run). Le credenziali Meta vere e proprie (access token, app
# secret, Page ID, Instagram Business Account ID) NON vanno qui: si
# configurano per organizzazione via API/UI (Connessioni e API -> Meta),
# cifrate a riposo — mai in un file .env, mai in chiaro in Mongo.
REAL_EXTERNAL_ACTIONS="false"
CONNECTOR_MODE="dry_run"   # impostare a "real" (solo insieme a REAL_EXTERNAL_ACTIONS=true) per abilitare il percorso reale

# URL pubblico con cui QUESTO backend e' raggiungibile da internet (richiesto
# SOLO per pubblicare su Meta un asset servito da questo stesso backend, es.
# un flyer generato — /api/flyer/assets/{id}; un asset gia' su CDN esterno,
# come un video Runway, non ne ha bisogno). Vuoto in sviluppo locale: la
# pubblicazione reale di quell'asset resta bloccata con un motivo esplicito
# finche' non e' configurato, mai un URL locale passato a Meta.
PUBLIC_BACKEND_URL=""

# ===== Lead Generation Specialist =====
# Nessuna variabile d'ambiente e' richiesta oggi: il dominio
# (backend/app/domains/leadgen/) funziona interamente con dati caricati
# dall'utente e dati gia' presenti in ACTELYA, senza alcun provider esterno.
# Gli adapter non configurati (directory/dataset pubblici, provider
# commerciale di lead/company data, connettore CRM) tornano sempre
# NON_DISPONIBILE, mai un risultato inventato — vedi
# backend/app/domains/leadgen/research.py::build_adapters().
#
# Per collegare in futuro un provider/CRM reale: aggiungere un nuovo
# ProspectSourceAdapter in research.py (stesso pattern di PublicUrlAdapter/
# InternalDataAdapter), registrarlo in build_adapters() con un source_id
# dedicato, e leggere qui SOLO le eventuali chiavi/URL del nuovo provider
# (mai inserire il secret di un CRM/provider di terze parti in questo file
# di esempio — solo il nome della variabile, valore vuoto).

# ===== Appointment Setter — app OAuth (Google Calendar / Microsoft Graph) =====
# Credenziali dell'APP OAuth, registrata UNA VOLTA dall'operatore ACTELYA
# presso il provider (mai per organizzazione): senza queste variabili il
# flusso "Connetti Google Calendar/Microsoft Graph" resta esplicitamente
# NON_CONFIGURATO per QUALUNQUE organizzazione — mai un errore generico, mai
# un crash. Calendly non usa OAuth in questa fase (Personal Access Token,
# inserito direttamente per organizzazione da Connessioni e API).
GOOGLE_CALENDAR_CLIENT_ID=""
GOOGLE_CALENDAR_CLIENT_SECRET=""
GOOGLE_CALENDAR_REDIRECT_URI=""      # es. https://<dominio-backend>/api/appointments/connections/oauth/callback
MS_GRAPH_CLIENT_ID=""
MS_GRAPH_CLIENT_SECRET=""
MS_GRAPH_REDIRECT_URI=""

# ===== Professional Tool Registry (backend/app/tools/registry.py) =====
# Catalogo canonico di ~50 provider professionali (LLM, ricerca web,
# media/audio, social, advertising, CRM, prospect research, comunicazioni,
# email marketing, calendari, analytics, SMS, e-commerce, documenti, OCR,
# automazioni). La lista ESATTA e aggiornata delle variabili d'ambiente
# previste per ciascun provider NON è duplicata qui (evita disallineamenti):
# è nel campo `env_vars` di ogni voce in registry.py, leggibile anche da
# `GET /api/tool-registry` (campo `env_vars` di ogni strumento). Un provider
# con `code_complete=False` nel registro non ha ancora un adapter reale:
# resta sempre NON_CONFIGURATO qualunque variabile venga impostata, finché
# non viene implementato — mai un nome soltanto spacciato per pronto.
